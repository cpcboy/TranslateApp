{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口、选区窗口、译文窗口：只开核心权限，前端不直接碰网络与文件系统",
  "windows": [
    "main",
    "capture",
    "overlay"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size"
  ]
}
